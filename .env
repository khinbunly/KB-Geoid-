# Telegram Bot API Token
TELEGRAM_BOT_TOKEN=8907224822:AAET1E4Eb2h_MYHd-8qJ6kXCt_DLqDzTuAo

# Application Environment (development, production, testing)
APP_ENV=production

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
