# ==========================================================
# EGM2008 Geoid Telegram Bot Configuration
# ==========================================================

# Telegram Bot API Token obtained from @BotFather (Required for live bot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Application Environment (development, production, testing)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Geoid Engine Backend (auto, proj, geographiclib)
GEOID_BACKEND=auto

# PROJ Network & Grid Cache Directory (optional)
PROJ_NETWORK=true
PROJ_CACHE_DIR=./.proj_cache

# File processing limits
MAX_UPLOAD_SIZE_MB=20
MAX_BATCH_ROWS=50000

# Rate limiting (requests per minute per user, 0 to disable)
RATE_LIMIT_PER_MINUTE=60
